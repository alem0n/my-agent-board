#!/bin/sh
# 提交前质量门禁（快速子集。依赖审计在 CI 执行）。
# 首次克隆后配置一次：git config core.hooksPath .githooks
# 仓库内统一 LF 行尾（见 .gitattributes）：CRLF 会让 ^M 进入命令名导致钩子失效。
if command -v make >/dev/null 2>&1; then
  make precommit || exit 1
else
  echo "提示：未安装 make，跳过本地门禁。CI 会运行 make check（见 AGENTS.md 第 2 节）。"
fi

# 密钥扫描（可选）：安装 gitleaks 后自动启用
# 安装：见 https://github.com/gitleaks/gitleaks 或包管理器
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact; then
    echo "检测到疑似密钥泄露。请移除密钥或使用 .env（已纳入 .gitignore）。"
    echo "误提交的密钥必须轮换。清理历史不能替代轮换。"
    exit 1
  fi
else
  echo "提示：未安装 gitleaks，跳过密钥扫描。安装方式见 AGENTS.md 第 8 节。"
fi
